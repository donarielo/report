# COOLKI · URLs sin extensión .html (o .php para las páginas con SEO server-side)
# Este archivo va en la raíz de public_html (junto a index.php, registro.html, etc.)

DirectoryIndex index.php index.html

RewriteEngine On

# Si alguien pide la página con .html o .php en la URL, redirige (301) a la versión limpia.
# Esto no afecta a backend/ (los .php ahí siguen funcionando exactamente igual).
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{THE_REQUEST} \s/+(.*)\.(html|php)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Sirve internamente el .php correspondiente cuando existe (index, landing-empresas: tienen
# SEO por servidor, ver README §20). El resto de páginas sigue sirviéndose como .html.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [NC,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]
